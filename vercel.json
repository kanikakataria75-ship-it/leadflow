{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd nifty_swing_bot/ui && npm install && npm run build",
  "outputDirectory": "nifty_swing_bot/ui/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-ME.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
