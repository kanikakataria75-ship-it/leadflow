# Copy to `.env` for local development and fill in real values.
# `.env` is git-ignored. NEVER commit real credentials.
# In production these are set in the hosting platform's environment settings,
# not in a file.

# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------

# The single password that gates the whole terminal. With this unset the
# backend refuses every login rather than opening up, and /api/health reports
# auth_configured:false so a misconfigured deploy is visible.
APP_PASSWORD=choose-a-long-random-passphrase

# Signs the session cookie. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset, a random one is generated per process, which means every restart
# silently signs everyone out. Set it explicitly in production.
SESSION_SECRET=generate-a-48-byte-urlsafe-token

# Postgres for the forward record. Without this the store falls back to a local
# SQLite file -- correct for development, WRONG on any host with an ephemeral
# filesystem, where the forward record would reset on every deploy.
# Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Anthropic API key for the LLM insight layer. The insight layer is optional:
# without a key everything else still runs and signals simply have no AI
# narrative attached.
ANTHROPIC_API_KEY=

# Override the model set in config.yaml.
# ANTHROPIC_MODEL=claude-sonnet-5

# Set to 0 ONLY for local http development, so the session cookie is accepted
# without TLS. Must be 1 (the default) in production.
COOKIE_SECURE=1

# Rate limits. Defaults shown; raise only if you know why.
# RATE_LIMIT_READS=120      # per 60s, per client
# RATE_LIMIT_SCANS=2        # per 3600s -- each scan fetches ~400 symbols
# RATE_LIMIT_LOGINS=8       # per 900s
