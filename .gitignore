# Secrets
.env

# Local data cache. Never committed: 270MB, and rebuildable from the vendors.
nifty_swing_bot/cache/

# Generated research artefacts. Ignored by default BUT the two files the
# terminal serves are force-included below -- without them the deployed
# Backtest and Book pages return 503, because they are the only source of the
# frozen results and the persisted series.
nifty_swing_bot/results/*
!nifty_swing_bot/results/leadflow_frozen_results.json
!nifty_swing_bot/results/leadflow_series.json

logs/

